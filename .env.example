# -----------------------------------------------------------------------------
# Required authentication
# -----------------------------------------------------------------------------
# API key -> tenant. Generate a long random key and never commit the real value.
# Example:
# TENANTS_JSON={"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef":{"tenant":"artist-backend"}}
TENANTS_JSON={}

# -----------------------------------------------------------------------------
# Reverse proxy / Portainer
# -----------------------------------------------------------------------------
CONVERTER_HOST=img-api.marcohuber-web.site
CADDY_NETWORK=caddy

# -----------------------------------------------------------------------------
# Input safety
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=33554432
MAX_PIXELS=50000000
MAX_DIMENSION=12000

# -----------------------------------------------------------------------------
# Output variants - aligned with the artist backend
# -----------------------------------------------------------------------------
THUMB_WIDTH=400
MEDIUM_WIDTH=1200
LARGE_WIDTH=2000

WEBP_QUALITY=82
WEBP_EFFORT=4

# AVIF is opt-in because encoding is CPU expensive on a small VPS.
ENABLE_AVIF=false
AVIF_QUALITY=45
AVIF_EFFORT=4

# -----------------------------------------------------------------------------
# VPS performance controls - baseline first, then benchmark
# -----------------------------------------------------------------------------
MAX_ACTIVE_JOBS=1
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=64

# Container limits. Adjust only after measuring docker stats.
CONVERTER_MEMORY_LIMIT=1g
CONVERTER_CPU_LIMIT=2.0
CONVERTER_TMP_SIZE=512m

# -----------------------------------------------------------------------------
# LEGACY VARIABLES - REMOVE FROM PORTAINER / .env
# -----------------------------------------------------------------------------
# OUTPUT_DIR       - removed; converter no longer stores files.
# PUBLIC_BASE_URL  - removed; converter no longer publishes URLs.
# HOST_IMAGES_PATH - removed; no persistent image bind mount is needed.
# ADMIN_TOKEN      - removed; this service has no admin API.
# PORT             - internal service port is intentionally fixed to 3000 in compose.
